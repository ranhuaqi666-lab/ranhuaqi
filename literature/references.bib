@article{Li2026,
  title   = {Contribution of laser surface texturing on Al/Zn-Al-Mg coated steel by CMT weld-brazing joining},
  author  = {Li, Fuxiang and Wang, Min and Yang, Likai and Xu, Youwei and Lin, Qiaoli and Shi, Yu},
  year    = {2026},
  journal = {International Communications in Heat and Mass Transfer},
  volume  = {179},
  pages   = {112181},
  doi     = {10.1016/j.icheatmasstransfer.2026.112181},
  url     = {https://linkinghub.elsevier.com/retrieve/pii/S0735193326017021},
  keywords = {CMT焊, 最新前沿文献, 金属间化合物, 抗拉强度, 铝钢连接, 界面调控, 激光表面织构, Zn-Al-Mg镀层钢},
  abstract = {Zn-Al-Mg coated steel, a novel composite coated steel material, exhibits exceptional corrosion resistance and selfhealing properties, leading to its widespread application in the automotive and steel industries. However, research on its weldability remains insufficient. In this study, laser texture technology is introduced to modify the surface of Zn-Al-Mg coated steel sheets. Driven by the surface textures, the melt flow and interfacial characteristics of the cold metal transfer (CMT) weld-brazed joints are improved, thereby enhancing the weldability and mechanical properties of the Al/Zn-Al-Mg coated steel joints. The research results show that the aluminum alloy filler metal achieves better wettability on the surface of Zn-Al-Mg coated steel sheets treated by laser surface texturing. Meanwhile, laser surface texturing can intensify the evaporation of Zn element, thereby reducing the heat for the growth of interfacial intermetallic compounds (IMCs) and thinning the harmful intermetallic compound layer of the joint. Thanks to the improved wettability and interfacial characteristics, the load-bearing capacity of the joint with laser surface texturing is ultimately increased over by 46\% compared with that of the untextured joint. This study presents a novel approach to enhancing the mechanical properties of CMT brazed joints within the Al/steel system.}
}

@article{Gao2026,
  title   = {Convolutional neural network based image recognition for crack severity detection and service life assessment of dissimilar metal welded joints},
  author  = {Gao, Shuting and Wang, Yushuang},
  year    = {2026},
  journal = {Materials Today Communications},
  volume  = {53},
  pages   = {115245},
  doi     = {10.1016/j.mtcomm.2026.115245},
  url     = {https://linkinghub.elsevier.com/retrieve/pii/S2352492826006343},
  keywords = {在线监测, 最新前沿文献, 金属间化合物, 铝钢连接, 激光焊, 卷积神经网络, 裂纹严重度, 疲劳寿命},
  abstract = {Dissimilar aluminum-steel joining is essential for lightweight multi-material structures but is limited by a narrow process window in which lack of fusion at low heat input competes with interfacial degradation at high heat input. This study presents an integrated framework combining process-window mapping, interfacial metallurgy, ordinal crack-severity grading using convolutional neural networks (CNNs), and fatigue-based service-life assessment for laser-joined Al-steel joints. A well-defined stable processing window was identified between under-processed and crack-prone regimes, characterized by a thin and continuous intermetallic layer (3.4 ± 0.5 μm), whereas over-processing resulted in significant thickening (11.8 ± 2.1 μm) with microcrack and void-chain formation. Mechanical performance showed a strong monotonic degradation with increasing crack severity, confirming severity as a physically meaningful descriptor of structural integrity. An ordinal CNN model achieved robust grading performance (quadratic-weighted κ = 0.91, macro-F1 = 0.86, AUROC = 0.94) with reliable confidence calibration (ECE = 0.024), enabling decision-oriented inspection. Fatigue analysis further demonstrated systematic life reduction with increasing severity, with clear separation in survival behavior and hazard escalation across grades. By integrating severity prediction with confidence-gated screening, the proposed framework reduced the estimated field failure rate from 12\% to 2\% (83\% reduction). These results establish a practical and interpretable pathway for linking process control, microstructural evolution, and AI-assisted inspection to improve manufacturability, reliability, and lifecycle performance of dissimilar metal joints.}
}

@article{Hu2026,
  title   = {Effect of Ti/Ni composite interlayer on the microstructure and mechanical properties of TRIP steel/aluminium alloy laser welded joints},
  author  = {Hu, Hao and Hu, Chunhua and Li, Xiaoying},
  year    = {2026},
  journal = {Journal of Materials Research and Technology},
  volume  = {44},
  pages   = {76-85},
  doi     = {10.1016/j.jmrt.2026.07.272},
  url     = {https://linkinghub.elsevier.com/retrieve/pii/S223878542602003X},
  keywords = {最新前沿文献, 金属间化合物, 抗拉强度, 铝钢连接, 激光焊, 界面调控, 中间层, TRIP钢},
  abstract = {How to ensure strong and stable join of dissimilar metals is an urgent technical challenge to be addressed for the mixed-use of such dissimilar metallic materials as high strength transformation-induced plasticity (TRIP) steel and light aluminium alloy for the manufacturing of lightweight and safe electrical vehicles. In this paper, the effect of adding a Ti–Ni composite interlayer to TRIP steel/aluminium alloy laser welded joints is investigated through comparing the composition, microstructure and mechanical properties of the conventional Fe–Al joint with the newly designed joints containing a Ni-interlayer (i.e. Fe–Ni–Al joint), a Ti-interlayer (i.e. Fe–Ti–Al joint) or a Ti–Ni composite interlayer (i.e. Fe–Ni/Ti–Al joint). The results show that the addition of a thin Ni, Ti or Ti/ Ni composite layer as an interlayer for laser welding can effectively increase the tensile shear force from 1465.54 N for the conventional Fe–Al joint to 1641.19 N, 1722.18 N and 1824.49 N respectively for the Fe–Ni–Al joint, the Fe–Ti–Al joint and the Fe–Ti/Ni–Al joint. Synergetic effect of adding both Ti and Ni has been achieved mainly through significantly reduced the thickness of brittle intermetallic compounds layer and effectively refined interface grain size thus alleviating the stress concentration and cracking at the interface.}
}

@article{Zheng2026,
  title   = {Influence of laser power on the microstructure and mechanical properties of aluminum/steel laser weld-brazing joints},
  author  = {Zheng, Min and Yang, Jin and Shen, Jiajia and Jiang, Qing and Ni, Jiaming and Chen, Yuhua and Xie, Jilin and Liang, He and Oliveira, J.P. and Zhang, Hua},
  year    = {2026},
  journal = {Materials Characterization},
  volume  = {240},
  pages   = {116840},
  doi     = {10.1016/j.matchar.2026.116840},
  url     = {https://linkinghub.elsevier.com/retrieve/pii/S1044580326008788},
  keywords = {最新前沿文献, 金属间化合物, 抗拉强度, 铝钢连接, 激光熔钎焊, 断裂位置, 激光功率},
  abstract = {The effects of laser power on the weld morphology, interfacial microstructure, and mechanical properties of laser Al-steel dissimilar welds were systematically investigated in the present study. At low laser power (1900 W–2100 W), a single τ5-Al7.2Fe1.8Si phase formed at the interface, while at medium and higher powers (2300 W, 2500 W and 2700 W), a dual intermetallic compounds (IMCs) layer consisting of θ-Fe (Al,Si)3 and τ5-Al7.2Fe1.8Si was observed and the thickness of the IMCs layer was also increased, reaching up to 4.5 μm. The joint fracture load per unit length initially increased and then declined with the thickening of the IMCs layer, reaching a peak of 241.8 N/mm at 2300 W. All joints exhibited brittle fracture along the IMCs layer under both tensile and fatigue loading. This study elucidates the evolution and formation mechanisms of IMCs in aluminum/steel laser weldbrazing, providing theoretical support for optimizing the performance of dissimilar metal joints in engineering applications.}
}

@article{Zhang2026,
  title   = {Modulating interfacial IMC evolution and mechanical performance in steel/Al joints using laser-assisted Cu–Zn/La2O3 nanocomposite interlayers},
  author  = {Zhang, Xiaobin and Zhang, Haowei and Xie, Weifeng and Yang, Haifeng and Zhao, Pengfei and Bian, Shuwang},
  year    = {2026},
  journal = {Materials Today Nano},
  volume  = {35},
  pages   = {100901},
  doi     = {10.1016/j.mtnano.2026.100901},
  url     = {https://linkinghub.elsevier.com/retrieve/pii/S2588842026001501},
  keywords = {CMT焊, 最新前沿文献, 金属间化合物, 抗拉强度, 铝钢连接, 界面调控, 中间层, 最新前沿},
  abstract = {The uncontrolled growth of brittle Fe–Al intermetallic compounds (IMCs) limits the mechanical reliability of Steel/Al welded joints. Here, a hybrid approach combining laser pre-melting with a Cu–Zn/La2O3 composite interlayer was developed to regulate interfacial reactions during cold metal transfer (CMT) welding of 304 stainless steel to 6061 aluminum alloy. This strategy enabled a dual-effect elemental partitioning mechanism, in which Cu and Zn promoted the formation of θ-Al2Cu precipitates, while La facilitated the precipitation of ternary LaFe7Al6 phases. These reactions effectively suppressed the growth of brittle Fe–Al IMCs and reduced the interfacial reaction layer thickness. Simultaneously, constitutional undercooling from Cu and Zn solutes, combined with heterogeneous nucleation induced by La2O3 particles, promoted a columnar-to-equiaxed transition (CET) in the fusion zone. This resulted in significant grain refinement from 32.2 ± 3 μm in the unmodified joint to 18.7 ± 3 μm in the modified joint, accompanied by a high-angle grain boundary fraction of 88.5\%. Consequently, the modified joints achieved improved mechanical properties, with a tensile-shear strength of 181.1 MPa (approximately 45\% higher than the unmodified joints) and a fracture elongation of ~2.0\%. This approach provides a feasible metallurgical route for enhancing the reliability of dissimilar Steel/Al joints.}
}

@article{MESJCCA8,
  title   = {TIG熔钎焊工艺对铝/钢异种金属焊接接头组织的影响},
  author  = {{王海林} and {黄华伟} and {王金凤} and {张元好}},
  year    = {2026},
  journal = {特种铸造及有色合金},
  volume  = {46},
  number  = {6},
  pages   = {866-870},
  doi     = {10.15980/j.tzzz.Y20250011},
  keywords = {TIG焊, 铝钢异种金属, 金属间化合物, 铝钢连接, AlSi12焊丝, 界面调控, 熔钎焊, 涂粉},
  abstract = {采用直径为1.2 mm的ER4043焊丝，通过不同TIG熔钎焊工艺，实现了5A02铝合金和Q235钢异种接头有效连接。通过使用金相显微镜（OM）、扫描电镜（SEM）和能谱仪（EDS），观察熔钎焊接头宏观形貌、界面特征。结果表明，未涂覆金属粉末的接头试样在焊缝区出现晶间裂纹，预置涂覆金属粉末试样焊缝成形性能优于未涂覆金属粉末的试样；铝合金侧热影响区受热后晶粒有粗大倾向，焊缝区组织为α-Al等轴晶和Al-Si共晶组织，Al-Si共晶均匀分布在α-Al晶界上；界面区附近Al和Fe原子沿着界面层相互扩散，形成多种Fe-Al金属间化合物，靠近钢侧主要为FeAl化合物，靠近铝侧以FeAl3化合物为主。}
}

@article{Wallerstein2026,
  title   = {Toward damage-tolerant aluminum–steel joints through power-modulated fiber laser welding-brazing},
  author  = {Wallerstein, Daniel and Calvo-García, Erik and Solla, Eugenio Luis and Lusquiños, Fernando and Arias-González, Felipe and Comesaña, Rafael and Salminen, Antti and Pou, Juan},
  year    = {2026},
  journal = {Materials Science and Engineering: A},
  volume  = {974},
  pages   = {150808},
  doi     = {10.1016/j.msea.2026.150808},
  url     = {https://linkinghub.elsevier.com/retrieve/pii/S0921509326010889},
  keywords = {最新前沿文献, 金属间化合物, 铝钢连接, 激光熔钎焊, 汽车轻量化, AlSi12焊丝, 断裂位置, 功率调制},
  abstract = {The development of damage-tolerant aluminum–steel joints is essential for lightweight structural applications exposed to dynamic loading. However, ensuring stable mechanical performance remains challenging due to the brittle nature and heterogeneous morphology of Fe–Al intermetallic compounds that form at the aluminum–steel interface. In this study, square butt joints between 6082 aluminum alloy and S275 structural steel were produced by fiber laser welding-brazing using Al–Si filler wire combined with preplaced Al–Si powder. Constant power (CP) and modulated power (MP) strategies were systematically compared through comprehensive mechanical and microstructural characterization. Power modulation refined the intermetallic morphology, promoted more homogeneous fracture behavior under vibration loading, and shifted fatigue crack initiation away from the aluminum–steel interface, thereby improving the overall damage tolerance of the joints and their suitability for structural applications in lightweight vehicle design. These findings demonstrate that laser power modulation, combined with Si-enriched fillers, offers a practical route to reliable aluminum–steel joints for dynamic service conditions.}
}

@article{7J9VCCVP,
  title   = {焊接速度对铝/钢异种金属激光熔钎焊接头组织及性能的影响},
  author  = {孙有平},
  year    = {2026},
  journal = {精密成形工程},
  volume  = {18},
  number  = {7},
  pages   = {143},
  doi     = {10.3969/j.issn.1674-6457.2026.07.013},
  url     = {https://d.wanfangdata.com.cn/periodical/jmcxgc202607013},
  keywords = {镀锌钢, 金属间化合物, 抗拉强度, 铝钢连接, 6061铝合金, 激光熔钎焊, 断裂位置, 焊接速度},
  abstract = {The work aims to employ the laser brazing-welding method to investigate the effects of welding speed on the microstructural characteristics and mechanical behaviors of joints between 6061-T6 aluminum alloy and Q235A galvanized steel, to provide a theoretical basis for achieving highly reliable connections between dissimilar aluminum and steel materials in lightweight structures, suppressing the growth of brittle intermetallic compounds (IMCs), and enhancing joint performance. The 6061-T6 aluminum alloy and Q235A galvanized steel were joined by a laser brazing-welding process with a 1.2 mm diameter ER2319 filler wire at different welding speeds. The macroscopic morphology and microstructure of the joints were characterized by optical microscopy and scanning electron microscopy (SEM), while the phase composition at the interface was analyzed by X-ray diffraction (XRD) and energy dispersive spectroscopy (EDS). Mechanical properties were evaluated with a microhardness tester and an electronic universal testing machine, focusing on the evolution of joint structure and properties with the welding speed. The results indicated that sound bonding between aluminum and steel was achieved at welding speeds ranging from 0.9 m/min to 1.8 m/min, whereas incomplete penetration occurred at 2.1 m/min, leading to poor joint integrity. The weld microstructure at various speeds consisted mainly of droplet-like and acicular dendrites along with fine equiaxed grains. As the welding speed increased, the thickness of the IMC layer at the joint interface decreased progressively, with a maximum value of 28.94 μm. The optimal mechanical properties were obtained at a welding speed of 1.21 m/min, with peak microhardness and tensile strength reaching 154.3HV and 128 MPa, respectively. Fractographic analysis revealed a brittle fracture mode, and secondary phase compounds in the fracture surface were found to directly deteriorate the mechanical performance of the joints. In conclusion, during the laser brazing-welding process, the variation of the welding speed will change the welding heat input and the solidification conditions of the molten pool, thereby affecting the evolution of microstructure and the formation and growth of the interface IMC layer, and ultimately significantly influencing the mechanical properties of the welded joint. Therefore, optimizing the welding speed is the key to further improving the forming quality and comprehensive performance of aluminum/ steel dissimilar metal welded joints.}
}

@article{Zhang2025,
  title   = {Experimental Study on Laser Lap Welding of Aluminum–Steel with Pre-Fabricated Copper–Nickel Binary Coating},
  author  = {Zhang, Hua and Gu, Huiyan and Ma, Dong},
  year    = {2025},
  journal = {Crystals},
  volume  = {15},
  number  = {4},
  pages   = {300},
  doi     = {10.3390/cryst15040300},
  url     = {https://www.mdpi.com/2073-4352/15/4/300},
  keywords = {金属间化合物, 抗拉强度, 铝钢连接, 6061铝合金, 激光焊, 界面调控, 铜镍镀层},
  abstract = {In order to solve the problem of poor weld quality caused by brittle metal compounds in the welding of dissimilar metals between aluminum and steel, a pre-welding treatment method of prefabricated copper–nickel binary coating between aluminum and steel has been proposed. Laser lap welding tests and weld performance tests were conducted using 6061 aluminum alloy and DP590 duplex steel with a thickness of 0.5 mm as base materials, with steel on top and aluminum on bottom. The research results indicate that the prefabricated copper–nickel binary coating can effectively suppress the formation of brittle phase compounds of Fe and Al; the increase of copper and nickel elements is beneficial for the formation of tough compounds such as (Fe, Cu, Ni)3Al, (Fe, Cu, Ni)Al3, and CuAl5 in the weld zone; when the thickness of the copper coating is 155 µm and the thickness of the nickel coating is 110 µm, the mechanical properties of the aluminum steel lap welding seam are the best, and the maximum shear force that can be withstood is 208.09 N, which is 56\% higher than uncoated sample.}
}

@article{Lahdo2025,
  title   = {In-process control of penetration depth for welding of dissimilar joints of steel and aluminum with two intersecting laser beams},
  author  = {Lahdo, Rabi and Seffer, Sarah and Seffer, Oliver and Hermsdorf, Jörg and Kaierle, Stefan},
  year    = {2025},
  journal = {Journal of Laser Applications},
  volume  = {37},
  number  = {2},
  pages   = {022018},
  doi     = {10.2351/7.0001603},
  url     = {https://pubs.aip.org/jla/article/37/2/022018/3342799/In-process-control-of-penetration-depth-for},
  keywords = {在线监测, 最新前沿文献, 抗拉强度, 铝钢连接, 6061铝合金, 激光焊, 熔深控制, 微观组织},
  abstract = {Dissimilar joints of steel and aluminum are in great demand in shipbuilding applications, such as connecting steel hulls to aluminum superstructures. For this welding application, an explosive-welded adapter is used, whose manufacturing is complex and cost-intensive. While searching for alternative welding processes, laser beam welding has emerged due to its specific advantages. Compared to other fusion joining processes, laser beam welding enables a better control of the weld metal mixing ratio and, thus, the microstructure. To achieve a constant weld metal mixing ratio and, thus, a homogeneous microstructure over the weld seam length, an in-process control of the penetration depth based on the analysis of spectral process emissions for lap welding of steel S355 (t = 5 mm) and aluminum alloy AA6062 (t = 12 mm) with two intersecting laser beams is developed in these investigations. The main result of using the process control is that the microstructure and the joint strength remain almost constant, despite varying welding speeds.}
}

@article{Zeng2025,
  title   = {Interfacial characteristics and strengthening mechanism of Al-steel dissimilar metal half-lap joint laser welding-brazing},
  author  = {Zeng, Yida and Li, Ruizhi and Li, Zhiyong and Yang, Zirui and Jiang, Lihong and Wang, Guangping and Cui, Junhua and Wang, Yan and Hong, Xin},
  year    = {2025},
  journal = {Journal of Materials Research and Technology},
  volume  = {36},
  pages   = {2003-2016},
  doi     = {10.1016/j.jmrt.2025.02.263},
  url     = {https://linkinghub.elsevier.com/retrieve/pii/S2238785425005101},
  keywords = {工程应用, 金属间化合物, 抗拉强度, 铝钢连接, 6061铝合金, 激光熔钎焊, 界面调控, 半搭接坡口},
  abstract = {A butt joint of laser welding-brazing SUS316 steel and 6061-T6 aluminium alloy was successfully achieved by using the half-lap type bevel without filler metal. The designed bevel effectively transforms the conventional butt joint into a half-lap joint, improves the weld formation, enhances the uniformity of interfacial reaction, and significantly improves the mechanical properties of the joint. This investigation focused on the effects of welding speed and bevel shape on weld appearance, microstructure and mechanical properties, and the mechanism of interface reaction caused by the difference in bevel shape was revealed. The results demonstrate that as welding speed decreases, the interfacial reaction between solid steel and liquid aluminium intensifies, and the thickness and type of intermetallic compounds increase. In comparison with joint without bevel, the half-lap type bevel has been shown to suppress defects such as porosity and flux inclusions, balance the temperature field in welding pool, promote the homogeneity of interfacial reaction, and enhance the average thickness of the intermetallic compounds layer from 1.97 μm to 4.59 μm under the same heat input condition. In addition to the species of intermetallic compounds, Fe2Al5, FeAl3 and FeAl, there are also Fe–Cr–Al and Fe–Ni–Al phases consisting of Cr and Ni atoms diffused into the interface from the solid steel, which increase the joint toughness to some extent. The maximum tensile strength of the half-lap bevelled joint can reach 125.42 MPa, which is 53.6\% higher than that of the joint without bevel.}
}

@article{Y7ZMPZXE,
