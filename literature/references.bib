@article{Song2009,
  title   = {Effects of Si additions on intermetallic compound layer of aluminum–steel TIG welding–brazing joint},
  author  = {Song, J.L. and Lin, S.B. and Yang, C.L. and Fan, C.L.},
  year    = {2009},
  journal = {Journal of Alloys and Compounds},
  volume  = {488},
  number  = {1},
  pages   = {217-222},
  doi     = {10.1016/j.jallcom.2009.08.084},
  url     = {https://linkinghub.elsevier.com/retrieve/pii/S0925838809016508},
  keywords = {TIG焊, Fe-Al冶金基础和IMC, 金属间化合物, 抗拉强度, 铝钢连接, AlSi12焊丝, 界面调控, Fe-Al合金基础},
  abstract = {Dissimilar metals of 5A06 aluminum alloy and AISI 321 stainless steel were butt joined successfully by TIG welding–brazing with 1100 pure Al, 4043 AlSi5 and 4047 AlSi12 ﬁller metals. Si additions in the ﬁller metal have great effects in preventing the growth of the IMC layer, and minimizing its thickness. The joint interface with pure aluminum consists of the -FeAl3 in aluminum side and -Fe2Al5 in steel side, while the interfaces with Al–Si ﬁller metals are the 5-Al7.2Fe1.8Si in aluminum side and -Fe(Al,Si)3 in steel side. And with 5 wt.\% of Si additions, the IMC layer has the optimum mechanical properties, and the tensile strength of the joint reaches 125.2 MPa. The growth mechanism of the IMC layers is controlled by the dissolution and diffusion of Fe atoms in the liquid. At the same time, Si atoms aggregate in the interface and participate the IMC layer’s formation.}
}

